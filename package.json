{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build-debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:build-debug:unix": "npm run android:sync && cd android && bash gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
